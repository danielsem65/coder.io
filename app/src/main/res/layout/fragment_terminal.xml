<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminal_bg">

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="8dp">

        <TextView
            android:id="@+id/terminal_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/terminal_text"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"
            android:text="@string/welcome_terminal" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_secondary"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ "
            android:fontFamily="monospace"
            android:textColor="@color/terminal_prompt"
            android:textSize="14sp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/terminal_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@color/bg_surface"
            android:fontFamily="monospace"
            android:textColor="@color/terminal_text"
            android:textColorHint="@color/text_secondary"
            android:hint="@string/hint_type_command"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:inputType="textNoSuggestions"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_send"
            android:contentDescription="@string/send"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:tint="@color/terminal_text" />

    </LinearLayout>

</LinearLayout>
